# Copy to .env and fill in real values. Never commit .env to the repository.
# Development defaults: PORT=3001, NODE_ENV=development

# Set to "production" to fail fast when required configuration is missing
NODE_ENV=development

# Port for the API + static frontend
PORT=3001

# Required in production. The server refuses to start without it when NODE_ENV=production.
# Generate a strong value with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Where the SQLite database and its backups are stored.
# Leave both unset for local development — they default to server/centre.sqlite
# and server/backups, which is what you want on your own machine.
#
# On Render these MUST point at the persistent disk, otherwise the database is
# wiped on every deploy and the app silently re-seeds demo data. See render.yaml.
# DB_PATH=/var/data/centre.sqlite
# BACKUPS_PATH=/var/data/backups